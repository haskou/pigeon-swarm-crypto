{
  "name": "@haskou/pigeon-swarm-crypto",
  "version": "0.0.0",
  "description": "Cryptographic primitives, key handling, and wire-format compatibility for Pigeon Swarm.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/compatibility.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.20.2"
  },
  "packageManager": "yarn@1.22.22",
  "keywords": [
    "pigeon-swarm",
    "cryptography",
    "encryption",
    "ed25519",
    "x25519",
    "aes-256-gcm",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haskou/pigeon-swarm-crypto.git"
  },
  "bugs": {
    "url": "https://github.com/haskou/pigeon-swarm-crypto/issues"
  },
  "scripts": {
    "lint": "eslint ./src --ext .ts",
    "lint:fix": "eslint ./src --ext .ts --fix",
    "test": "yarn lint && yarn test:unit",
    "test:unit": "jest --runInBand",
    "test:coverage": "NODE_ENV=test jest --collect-coverage",
    "build": "rm -rf dist/ && tsc"
  },
  "dependencies": {
    "@haskou/value-objects": "7.0.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "buffer": "^6.0.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@haskou/eslint-config": "^0.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "jest-extended": "^7.0.0",
    "legacy-value-objects-v2": "npm:@haskou/value-objects@2.10.0",
    "legacy-value-objects-v3": "npm:@haskou/value-objects@3.0.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}

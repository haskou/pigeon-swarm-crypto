{
  "name": "@haskou/pigeon-swarm-crypto",
  "version": "0.0.0",
  "description": "Cryptographic primitives, key handling, and wire-format compatibility for Pigeon Swarm.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mls": {
      "types": "./dist/mls/index.d.ts",
      "import": "./dist/mls/index.mjs",
      "require": "./dist/mls/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/compatibility.md",
    "docs/key-lifecycle-review.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/private-operation-signatures.md",
    "docs/private-genesis-signatures.md",
    "docs/private-control-signatures.md",
    "docs/private-freshness-proofs.md",
    "docs/user-root-key.md",
    "docs/mls-key-lifecycle.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.20.2"
  },
  "packageManager": "yarn@1.22.22",
  "keywords": [
    "pigeon-swarm",
    "cryptography",
    "encryption",
    "ed25519",
    "x25519",
    "aes-256-gcm",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haskou/pigeon-swarm-crypto.git"
  },
  "bugs": {
    "url": "https://github.com/haskou/pigeon-swarm-crypto/issues"
  },
  "scripts": {
    "lint": "eslint ./src --ext .ts",
    "lint:fix": "eslint ./src --ext .ts --fix",
    "test": "yarn lint && yarn test:unit",
    "test:unit": "jest --runInBand",
    "test:coverage": "yarn test:coverage:unit && yarn test:coverage:mls",
    "test:coverage:unit": "NODE_ENV=test jest --collect-coverage",
    "test:coverage:mls": "yarn build && node tests/runtime/mls-create-transaction.cjs && c8 --clean=true --temp-directory=tests/.coverage-mls --reporter=none node tests/runtime/mls-key-lifecycle.cjs && c8 --clean=false --temp-directory=tests/.coverage-mls --reporter=none node tests/runtime/private-delivery.cjs && c8 --clean=false --temp-directory=tests/.coverage-mls --reporter=none node tests/runtime/mls-validation.cjs && c8 report --temp-directory=tests/.coverage-mls --report-dir=tests/coverage-mls --reporter=text --reporter=lcov --exclude-after-remap --exclude=node_modules/** --exclude=src/*.ts --exclude=src/errors/** --exclude=src/hashes/** --exclude=src/internal/** --exclude=src/mls/index.ts --exclude=tests/** --check-coverage --branches=100 --functions=100 --lines=100 --statements=100",
    "build": "rm -rf dist/ && tsc && esbuild src/mls/index.ts --bundle --platform=browser --format=esm --target=es2022 --sourcemap --outfile=dist/mls/index.mjs && esbuild src/mls/index.ts --bundle --platform=node --format=cjs --target=node20 --sourcemap --outfile=dist/mls/index.cjs",
    "test:runtime": "node --stack_size=256 tests/runtime/base64.cjs",
    "test:private-signatures": "node tests/runtime/private-signatures.cjs",
    "test:private-genesis": "node tests/runtime/private-genesis.cjs",
    "test:private-control": "node tests/runtime/private-control.cjs",
    "test:private-freshness": "node tests/runtime/private-freshness.cjs",
    "test:user-root-key": "node tests/runtime/user-root-key.cjs",
    "test:mls-key-lifecycle": "node tests/runtime/mls-key-lifecycle.cjs",
    "test:mls-browser": "node tests/runtime/mls-browser.cjs",
    "test:mls-standard-vectors": "node tests/runtime/mls-standard-vectors.mjs",
    "test:private-delivery": "node tests/runtime/private-delivery.cjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "^2.2.0",
    "buffer": "^6.0.3",
    "canonicalize": "2.1.0",
    "jsonc-parser": "3.3.1",
    "ts-mls": "1.6.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@haskou/eslint-config": "^0.2.2",
    "@haskou/value-objects": "7.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "c8": "12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "jest-extended": "^7.0.0",
    "legacy-value-objects-v2": "npm:@haskou/value-objects@2.10.0",
    "legacy-value-objects-v3": "npm:@haskou/value-objects@3.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@haskou/value-objects": "^7.0.0"
  },
  "browser": {
    "jsonc-parser": "jsonc-parser/lib/esm/main.js"
  }
}

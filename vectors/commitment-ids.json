{
  "description": "Commitment ids and state digests of Pigeon Swarm. Every id is recomputed from args by the library, and the preimage shows the exact hashed text. invalid cases must throw InvalidCommitmentError; distinct cases show that a non-canonical preimage never reaches the id.",
  "algorithms": {
    "call": "first 16 bytes of sha256(utf8(creator + \":\" + nonce)), byte 6 = (byte 6 mod 16) + 128, byte 8 = (byte 8 mod 64) + 128, lowercase hex 8-4-4-4-12",
    "community": "base64url(sha256(utf8(RFC 8785 {networkId, nonce, ownerIdentityId})))",
    "communityChannel": "first 24 hex chars of sha256(utf8(JSON [\"channel\", communityId, creatorIdentityId, createdAt]))",
    "communityRole": "first 24 hex chars of sha256(utf8(JSON [\"role\", communityId, creatorIdentityId, createdAt]))",
    "communityRequest": "first 24 hex chars of sha256(utf8(JSON [communityId, type, creatorIdentityId, identityId, createdAt]))",
    "communityModerationLog": "first 24 hex chars of sha256(utf8(JSON [communityId, actorIdentityId, action, targetType, targetId, createdAt]))",
    "communityInviteToken": "base64url(sha256(utf8(JSON [communityId, creatorIdentityId, nonce, maxUses, expiresAt or null])))",
    "mlsRecord": "base64url(sha256(utf8(RFC 8785 {epoch?, groupId, kind, payload, recipientIdentityId?}))); an empty recipient is omitted, epoch 0 is kept",
    "privateBlobOwner": "lowercase hex HMAC-SHA256(key = 32-byte salt, utf8(identityId))",
    "stateDigest": "base64url(sha256(utf8(RFC 8785 value)))",
    "bytesDigest": "base64url(sha256(bytes))",
    "communityFrontiers": "base64url(sha256(utf8(JSON [[communityId, sorted heads]...] sorted by communityId))); sorting uses UTF-16 code units"
  },

{
  "algorithms": {
    "body": "RFC 8785 canonical JSON of {communityId, identityId, invitationId, networkId}. communityId is 1 to 128 base64url characters; identityId is the canonical base64 SPKI body of a strict Ed25519 key that is not of small order; invitationId is the canonical unpadded base64url of 32 bytes (43 characters); networkId is a UUID (8-4-4-4-12 hexadecimal digits)",
    "consent": "Ed25519 by the joiner identity key over utf8(\"pigeon:community-invitation-consent:v1\\n\" + body), canonical unpadded base64url of the 64 signature bytes (86 characters), verified under fields.identityId",
    "invitationKey": "canonical unpadded base64url of the raw 32-byte Ed25519 public key of the seed (43 characters); strict decoding refuses non-canonical and small-order points",
    "possession": "Ed25519 by the invitation key over utf8(\"pigeon:community-invitation-possession:v1\\n\" + body), canonical unpadded base64url of the 64 signature bytes (86 characters), verified under the invitationKey of the invitation",
    "secret": "32 random bytes as canonical unpadded base64url (43 characters), carried only in the link fragment",
    "seed": "HKDF-SHA256(ikm = secret bytes, salt = empty, info = utf8(\"pigeon:community-invitation-key:v1\"), L = 32), the Ed25519 seed of the invitation key",
    "verification": "strict RFC 8032: S >= L, a non-canonical R or key, and a small-order key are refused; signatures and keys decode only from their single canonical text"
  },
  "description": "Fixed vectors for signed community invitations. derivations map a link secret to the invitation key, proofs map the four fields to both preimages and signatures, and every invalid case must be refused with InvalidCommunityInvitationError. The first proof is the member_joined_invitation operation of community-operation.json. Keys are disposable test keys.",

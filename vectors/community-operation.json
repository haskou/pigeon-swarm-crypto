{
  "algorithms": {
    "canonicalization": "RFC 8785 JSON Canonicalization Scheme (npm package canonicalize)",
    "communityId": "base64url(sha256(utf8(canonicalize({networkId, nonce, ownerIdentityId}))))",
    "deviceCredential": "mutation.author.deviceCredential is the PEM-less base64 public key of the signing device, here the identity's own key acting as its first device, so it equals identityId and the same key signs",
    "digest": "base64url(sha256(utf8(canonicalize(payload without id and identitySignature)))), also the value other operations list in parents",
    "identitySignature": "ed25519 by the author's identity key (authorIdentityId) over utf8(identitySigningContent), standard base64 with padding (88 characters); stored in the payload and sent as requestOperation.identitySignature",
    "identitySigningContent": "\"pigeon:community-operation:v1\\n\" + recordId",
    "invitation": "invitation_created args.invitationKey is the invitation public key derived from the link secret, and its digest is the invitation id. member_joined with method invitation carries invitationId and the possession and consent proofs of community-invitation.json",
    "payloadDigest": "base64url(sha256(utf8(canonicalize(payload)))), payload including id and identitySignature",
    "recordId": "community:<communityId>:op:<digest>",
    "signature": "ed25519 over utf8(signingContent), standard base64 with padding (88 characters)",
    "signingContent": "\"pigeon:public-mutation:v2\\n\" + canonicalize(mutationBody), mutationBody being the mutation without its signature"
  },

{
  "description": "Fixed, byte-exact vectors for device pairing: the invitation, request and completion signing preimages, their Ed25519 signatures and the short authentication (verification) code. Keys derive from sha256(utf8(\"pigeon-vector:device-pairing:<role>\")) as an Ed25519 seed. Regenerate only through a reviewed protocol change.",
  "algorithms": {
    "invitation": "signingPayload = JSON.stringify({domain:\"pigeon:device-pairing:invitation:v1\", invitation}), invitation keys authorCredential, epoch, expiresAt, identityId, pairingId, revision, version in this order; signed by authorCredential.",
    "request": "signingPayload = JSON.stringify({domain:\"pigeon:device-pairing:request:v1\", request}), request keys authorizedAt, invitation, operationId, proofOfPossession, targetCredential, transportPublicKey, version in this order; signed by targetCredential.",
    "completion": "signingPayload = JSON.stringify({completion, domain:\"pigeon:device-pairing:completion:v1\"}), completion keys authorCredential, encryptedMaterial, epoch, identityId, operationId, pairingId, revision, version in this order; signed by authorCredential.",
    "signature": "Ed25519 (pure, no prehash) over utf8(signingPayload), standard base64 with padding (88 characters).",
    "verificationCode": "digest = sha256(utf8(JSON.stringify({domain:\"pigeon:device-pairing:verification:v1\", operationId, pairingId, targetCredential, transportPublicKey}))); value = big-endian uint64 of digest[0..8] mod 10^10; zero-padded to 10 digits and split 5 + space + 5.",
    "credentials": "authorCredential, targetCredential and transportPublicKey are full SPKI PEM strings (113 characters); identityId is the PEM body."
  },

{
  "description": "Group mailbox control letters: a control record signed by the sender identity and sealed to one recipient identity. valid cases open with the recipient key and the expected sender; invalid cases must throw InvalidGroupMailboxControlLetterError. sealed values are randomized, so seal is checked by opening.",
  "algorithms": {
    "signingContent": "\"pigeon:group-mailbox-control-letter:v1\\n\" + RFC 8785 {conversationId, kind: \"group-mailbox-control-letter\", payload, recipientIdentityId, senderIdentityId, sentAt}",
    "signature": "ed25519 over utf8(signingContent) with the sender identity key, standard base64 with padding",
    "sealedPlaintext": "RFC 8785 of the signed fields plus signature",
    "sealed": "PublicKey.encrypt(sealedPlaintext) to the recipient identity key (v2.x25519-hkdf-sha256-aes-256-gcm)",
    "identityIds": "PEM bodies of the Ed25519 identity keys",
    "payload": "canonical unpadded base64url of the control record bytes",
    "sentAt": "milliseconds since the epoch, a non-negative safe integer"
  },

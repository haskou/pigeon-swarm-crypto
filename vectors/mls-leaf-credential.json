{
  "description": "The MLS basic-credential identity of a Pigeon Swarm leaf (MlsLeafCredential). It binds the leaf MLS signature public key to an identity and one of its devices.",
  "algorithms": {
    "message": "\"pigeon:mls-leaf-credential:v2\\n\" + RFC 8785 canonical JSON of {deviceCredential, identityId, signaturePublicKey: unpadded base64url(signature public key)}",
    "identity": "utf8(identityId + NUL + deviceCredential + NUL + identitySignature + NUL + deviceSignature)",
    "identityId": "the base64 SPKI body of the identity Ed25519 public key: 59 base64 characters and one \"=\"",
    "deviceCredential": "the device Ed25519 public key as PEM: \"-----BEGIN PUBLIC KEY-----\\n\" + 60 base64 characters + \"\\n-----END PUBLIC KEY-----\\n\"",
    "signatures": "strict (RFC 8032, zip215 false) Ed25519 over utf8(message) by the identity key and by the device key, standard base64 with padding",
    "limits": "identity at most 1024 bytes, strict UTF-8, exactly four parts"
  },
